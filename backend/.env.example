NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# auto = try MongoDB, fall back to in-memory if unreachable; mongo = require MongoDB; memory = force in-memory
DB_ENGINE=auto
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.yfabnsv.mongodb.net/quickmart?retryWrites=true&w=majority
SEED_ON_START=true

# --- Auth / JWT ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (optional; falls back to in-memory cache) ---
REDIS_URL=

# --- Payments (optional; mock gateway used when blank) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps (optional; offline estimator used when blank) ---
GOOGLE_MAPS_API_KEY=

# --- Image upload / Cloudinary (optional; local disk storage used when blank) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (optional; console transport used when blank) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuickMart <no-reply@quickmart.co>

# --- Delivery defaults ---
DELIVERY_FEE=39
FREE_DELIVERY_THRESHOLD=499
DEFAULT_DELIVERY_RADIUS_KM=8
